{
  "name": "folio",
  "version": "0.2.0",
  "private": true,
  "description": "Folio \u2014 a local-first PDF suite for macOS, Windows and Chrome.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @folio/desktop tauri dev",
    "dev:desktop:web": "pnpm --filter @folio/desktop dev",
    "dev:extension": "pnpm --filter @folio/chrome-extension dev",
    "build:desktop": "pnpm --filter @folio/desktop tauri build",
    "build:desktop:macos": "pnpm --filter @folio/desktop tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:desktop:windows": "pnpm --filter @folio/desktop tauri build --bundles nsis,msi",
    "build:desktop:linux": "pnpm --filter @folio/desktop tauri build --bundles deb",
    "build:desktop:web": "pnpm --filter @folio/desktop build",
    "build:extension": "pnpm --filter @folio/chrome-extension build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --workspace --locked",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "capabilities:generate": "tsx scripts/generate-capabilities.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "font-metrics:generate": "tsx scripts/generate-font-metrics.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e:desktop": "node tests/desktop/tauri-driver.e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.7.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
