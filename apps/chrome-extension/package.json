{
  "name": "@folio/chrome-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Folio for Google Chrome (Manifest V3).",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "package": "vite build && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@folio/document-model": "workspace:*",
